  {
    "name": "Atlassian",
    "domain": "atlassian.com",
    "strategy": "register",
    "steps": [
      {
        "method": "GET",
        "url": "https://id.atlassian.com/login",
        "headers": {
          "Referer": "https://id.atlassian.com/",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          "Origin": "https://id.atlassian.com"
        },
        "capture": [
          {
            "var": "csrfToken",
            "regex": "&quot;csrfToken&quot;:&quot;([^&]+)",
            "group": 1
          }
        ]
      },
      {
        "method": "POST",
        "url": "https://id.atlassian.com/rest/check-username",
        "headers": {
          "Referer": "https://id.atlassian.com/",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          "Origin": "https://id.atlassian.com"
        },
        "form": {
          "csrfToken": "{csrfToken}",
          "username": "{email}"
        }
      }
    ],
    "match": {
      "exists": [
        {
          "body_not_contains": [
            "signup"
          ]
        }
      ],
      "not_exists": [
        {
          "json": {
            "key": "action",
            "value": "signup"
          }
        }
      ]
    },
    "enabled": true
  },
  {
    "name": "BlaBlaCar",
    "domain": "blablacar.com",
    "strategy": "register",
