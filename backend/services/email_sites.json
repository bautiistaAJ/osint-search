  {
    "name": "Evernote",
    "domain": "evernote.com",
    "strategy": "login",
    "steps": [
      {
        "method": "GET",
        "url": "https://www.evernote.com/Login.action",
        "headers": {
          "Referer": "https://www.evernote.com/Login.action"
        },
        "capture": [
          {
            "var": "hpts",
            "regex": "document.getElementById\\(\"hpts\"\\).value = \"([^\"]+)\"",
            "group": 1
          },
          {
            "var": "hptsh",
            "regex": "document.getElementById\\(\"hptsh\"\\).value = \"([^\"]+)\"",
            "group": 1
          },
          {
            "var": "sourcePage",
            "regex": "<input type=\"hidden\" name=\"_sourcePage\" value=\"([^\"]+)\"",
            "group": 1
          },
          {
            "var": "fp",
            "regex": "<input type=\"hidden\" name=\"__fp\" value=\"([^\"]+)\"",
            "group": 1
          }
        ]
      },
      {
        "method": "POST",
        "url": "https://www.evernote.com/Login.action",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
          "X-Requested-With": "XMLHttpRequest",
          "Origin": "https://www.evernote.com",
          "Referer": "https://www.evernote.com/Login.action"
        },
        "form": {
          "username": "{email}",
          "evaluateUsername": "",
          "hpts": "{hpts}",
          "hptsh": "{hptsh}",
          "analyticsLoginOrigin": "login_action",
          "clipperFlow": "false",
          "showSwitchService": "true",
          "usernameImmutable": "false",
          "_sourcePage": "{sourcePage}",
          "__fp": "{fp}"
        }
      }
    ],
    "match": {
      "exists": [
        {
          "body_contains": [
            "usePasswordAuth"
          ]
        }
      ],
      "not_exists": [
        {
          "body_contains": [
            "displayMessage"
          ]
        }
      ]
    },
    "enabled": true
  },
  {
    "name": "Facebook",
