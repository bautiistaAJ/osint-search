          "Accept": "application/json",
          "Referer": "https://www.blablacar.com/",
          "Origin": "https://www.blablacar.com"
        },
        "capture": [
          {
            "var": "appToken",
            "regex": "\"appToken\":\"([^\"]+)\"",
