      {
        "method": "GET",
        "url": "https://edge.blablacar.com/auth/validation/email/{email}",
        "headers": {
          "Authorization": "Bearer {appToken}",
          "Accept": "application/json"
        }
      }
    ],
    "match": {
      "exists": [
        {
          "json": {
            "key": "exists",
            "value": true
          }
        }
      ],
      "not_exists": [
        {
          "json": {
            "key": "exists",
            "value": false
          }
        }
      ]
    },
    "enabled": true
  },
  {
    "name": "Buy Me a Coffee",
    "domain": "buymeacoffee.com",
    "strategy": "register",
    "steps": [
      {
        "method": "GET",
        "url": "https://www.buymeacoffee.com/",
        "headers": {
          "Accept": "application/json, text/javascript, */*; q=0.01",
          "X-Requested-With": "XMLHttpRequest",
          "Origin": "https://www.buymeacoffee.com"
        },
        "capture": [
          {
            "var": "csrf",
            "regex": "name=[\"']bmc_csrf_token[\"'][^>]*value=[\"']([^\"']+)",
            "group": 1
          }
        ]
      },
      {
        "method": "POST",
        "url": "https://www.buymeacoffee.com/auth/validate_email_and_password",
        "headers": {
          "Accept": "application/json, text/javascript, */*; q=0.01",
          "X-Requested-With": "XMLHttpRequest",
          "Origin": "https://www.buymeacoffee.com",
          "Cookie": "bmccsrftoken={csrf}"
        },
        "form": {
          "email": "{email}",
          "password": "aB3dE5fG7hI9jK1lM2nO",
          "bmc_csrf_token": "{csrf}"
        }
      }
    ],
    "match": {
      "exists": [
        {
          "json": {
            "key": "status",
            "value": "FAIL"
          }
        }
      ],
      "not_exists": [
        {
          "json": {
            "key": "status",
            "value": "SUCCESS"
          }
        }
      ]
    },
    "enabled": true
  },
